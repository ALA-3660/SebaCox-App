# ==============================================================================
# SebaCox Project .gitignore
# Covers Python, Django, Flutter, Dart, Node, IDEs, and Environment Secrets
# ==============================================================================

# Node / Frontend build artifacts
node_modules/
dist/
coverage/

# Environment files and credentials (CRITICAL)
.env*
!.env.example
*.pem
*.key
*.cert

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.log
local_settings.py

# Celery
celerybeat-schedule
celerybeat.pid

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.epk
*.ipa
*.apk
app.*.symbols
flutter_*.png

# Operating Systems & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
