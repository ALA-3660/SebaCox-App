# ==============================================================================
# SebaCox Backend Environment Configuration (.env.example)
# "মানুষের প্রয়োজন থেকে সেবার সমাধান।"
# NEVER commit the real .env file with real secrets to version control.
# ==============================================================================

# General
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secure-random-secret-key-min-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://sebacox_user:sebacox_password@127.0.0.1:5432/sebacox_db

# Redis
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://127.0.0.1:6379/1

# Celery & Workers
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS & CSRF (Comma-separated URLs for Flutter development & production web)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Logging Level (INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Phase 2: Authentication & Identity Configuration
AUTH_USER_MODEL=authentication.User
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ALLOW_DEV_OTP=True
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
